# Bütün mətn faylları serverdə (Linux) LF ilə saxlanılır
* text=auto eol=lf

*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
.htaccess text eol=lf

# İkili fayllar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
