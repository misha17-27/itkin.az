# Lokal qurma faylları
.env.build

# Admin panelinin ayarları — şifrənin hash-i burada saxlanılır,
# ona görə serverdə qalmalı, repozitoriyaya düşməməlidir
/data/settings.php

# Panelin istifadəçiləri — şifrə hash-ləri
/data/users.php

# Yazı zamanı yaranan müvəqqəti fayllar
/data/*.tmp

# Ehtiyat nüsxələr, zibil qutusu, əlaqə jurnalı — serverdə qalır.
# Qoruyucu .htaccess isə repozitoriyada olmalıdır, yoxsa serverdə
# storage/ qovluğu (müraciətlərdəki şəxsi məlumatlar da daxil) açıq qalar.
/storage/*
!/storage/.htaccess

# Redaktor və sistem faylları
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
